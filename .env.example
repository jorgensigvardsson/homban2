# Optional overrides for local development. Copy to .env and load it in your
# shell before `npm run dev` (the npm scripts don't read .env automatically).
# `docker compose up` does read .env automatically, via env_file in
# docker-compose.yml.

# --- Reverse proxy (proxy/) ---
# HTTPS port the browser connects to. Use 8443 if 443 is taken.
PROXY_HTTPS_PORT=443
# Plain HTTP port that redirects to HTTPS. Set to 0 to disable.
PROXY_HTTP_PORT=80
# Where the proxy forwards to.
BACKEND_TARGET=http://127.0.0.1:8080
FRONTEND_TARGET=http://127.0.0.1:5173

# --- Backend (backend/) ---
PORT=8080
HOST=127.0.0.1
APP_ENV=development
LOG_LEVEL=info
LOG_FORMAT=text

# --- Sessions ---
# Signs session tokens (HS256). REQUIRED unless APP_ENV=development, where a
# built-in development value is used instead. At least 32 characters.
# Deliberately unrelated to the TLS certificate: TLS terminates in front of
# the app (the local dev proxy, or a reverse proxy in front of a real
# deployment), so the app cannot read that key, and a certificate can rotate
# on its own schedule.
#   Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=
JWT_ISSUER=homban
JWT_AUDIENCE=homban-web
# How long a session lasts before the user signs in again.
# Defaults to 30 days when APP_ENV=development (fewer interruptions while
# building), and to 12h otherwise.
# SESSION_TTL=12h
AUTH_COOKIE_NAME=homban_session
# Only ever disable in development, and only if not serving over TLS.
AUTH_COOKIE_SECURE=true

# --- Sign-in codes (one-time passwords) ---
OTP_LENGTH=6
OTP_TTL=10m
# Wrong guesses allowed before the code is voided.
OTP_MAX_ATTEMPTS=5
# Cooldown before the same address may request another code.
OTP_RESEND_AFTER=60s

# --- Database (unset locally; the in-memory store is used instead) ---
# Path to the SQLite database file. docker-compose.yml sets this to a path
# under the /data volume mounted from ./devdata on the host.
# SQLITE_PATH=devdata/homban.db

# --- Recognized users ---
# Comma-separated "email:role" pairs (roles: admin, user). Unset locally: any
# syntactically valid address may sign in as admin, so development needs no
# setup. REQUIRED unless APP_ENV=development — the server refuses to start
# without it, same as JWT_SECRET.
# RECOGNIZED_USERS=you@example.com:admin,other@example.com:user

# --- Outgoing mail (SMTP) ---
# Unset locally; sign-in codes print to stdout instead (see
# `deliveredToStdout` in the request-code response). Once SMTP_HOST is set,
# codes are actually mailed via STARTTLS on SMTP_PORT (a provider offering
# only implicit TLS on port 465 is not supported). A Gmail account with an
# app password (not your normal password) works fine here:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=<16-character app password>
#   SMTP_FROM=you@gmail.com
# SMTP_FROM may include a display name, e.g. SMTP_FROM=Homban <you@gmail.com>
# — do NOT wrap it in quotes: env_file values are taken literally (unlike a
# shell), so quotes become part of the value instead of being stripped, and
# the address fails to parse. A non-ASCII display name is fine as plain
# UTF-8 here; it is MIME-encoded automatically before being sent.
# With a Microsoft/Exchange Online account, SMTP_FROM must be the same
# address as SMTP_USERNAME unless that account has been granted "Send As"
# permission for the other address — otherwise sending fails with
# "554 5.2.252 SendAsDenied".
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
