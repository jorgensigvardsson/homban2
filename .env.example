# Optional overrides for local development. Copy to .env and load it in your
# shell before `npm run dev` (nothing reads .env automatically yet).

# --- Reverse proxy (proxy/) ---
# HTTPS port the browser connects to. Use 8443 if 443 is taken.
PROXY_HTTPS_PORT=443
# Plain HTTP port that redirects to HTTPS. Set to 0 to disable.
PROXY_HTTP_PORT=80
# Where the proxy forwards to.
BACKEND_TARGET=http://127.0.0.1:8080
FRONTEND_TARGET=http://127.0.0.1:5173

# --- Backend (backend/) ---
PORT=8080
HOST=127.0.0.1
APP_ENV=development
LOG_LEVEL=info
LOG_FORMAT=text

# --- Sessions ---
# Signs session tokens (HS256). REQUIRED unless APP_ENV=development, where a
# built-in development value is used instead. At least 32 characters.
# Deliberately unrelated to the TLS certificate: TLS terminates at the Azure
# ingress, where the app cannot read the key, and managed certificates rotate
# on their own schedule.
#   Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=
JWT_ISSUER=homban
JWT_AUDIENCE=homban-web
# How long a session lasts before the user signs in again.
# Defaults to 30 days when APP_ENV=development (fewer interruptions while
# building), and to 12h otherwise.
# SESSION_TTL=12h
AUTH_COOKIE_NAME=homban_session
# Only ever disable in development, and only if not serving over TLS.
AUTH_COOKIE_SECURE=true

# --- Sign-in codes (one-time passwords) ---
OTP_LENGTH=6
OTP_TTL=10m
# Wrong guesses allowed before the code is voided.
OTP_MAX_ATTEMPTS=5
# Cooldown before the same address may request another code.
OTP_RESEND_AFTER=60s

# --- Azure Cosmos DB (unset locally; the in-memory store is used instead) ---
# COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# COSMOS_DATABASE=homban
# COSMOS_CONTAINER=items
