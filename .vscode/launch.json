{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug backend",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/cmd/server",
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "APP_ENV": "development",
        "LOG_LEVEL": "debug"
      }
    },
    {
      "name": "Debug proxy",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--workspace", "proxy", "run", "start"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
